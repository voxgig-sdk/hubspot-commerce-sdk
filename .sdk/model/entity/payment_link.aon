  name: "payment_link"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /commerce/payment-links/2026-09/payment-links"
            json: "{\"operationId\":\"post-/commerce/payment-links/2026-09/payment-links\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"example\":null,\"schema\":{\"example\":null,\"properties\":{\"acceptedPaymentMethods\":{\"description\":\"An array of accepted payment methods for the payment link. Valid values include 'CREDIT_OR_DEBIT_CARD', 'ACH', 'SEPA', 'BACS', and 'PADS'.\",\"example\":null,\"items\":{\"enum\":[\"CREDIT_OR_DEBIT_CARD\",\"ACH\",\"SEPA\",\"BACS\",\"PADS\",\"AFFIRM\",\"KLARNA\"],\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"additionalFormFields\":{\"description\":\"An array of PaymentLinkFormField objects representing additional form fields to be included in the payment link.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"description\":{\"description\":\"A description of the form field, providing additional context or instructions, represented as a string.\",\"example\":null,\"type\":\"string\"},\"isRequired\":{\"description\":\"A boolean indicating whether this form field is required to be filled out.\",\"example\":null,\"type\":\"boolean\"},\"label\":{\"description\":\"The label for the form field, which is displayed to users, represented as a string.\",\"example\":null,\"type\":\"string\"},\"objectType\":{\"description\":\"The type of object this form field is associated with, represented as a string. Valid values include 'CONTACT' and 'COMPANY'.\",\"enum\":[\"COMPANY\",\"CONTACT\"],\"example\":null,\"type\":\"string\"},\"options\":{\"description\":\"An array of options available for this form field, each represented as a FormFieldOption object.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"description\":{\"description\":\"A string providing additional information or context about the form field option.\",\"example\":null,\"type\":\"string\"},\"label\":{\"description\":\"A string representing the display name of the form field option.\",\"example\":null,\"type\":\"string\"},\"value\":{\"description\":\"A string representing the underlying value associated with the form field option.\",\"example\":null,\"type\":\"string\"}},\"required\":[\"label\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},\"propertyName\":{\"description\":\"The name of the property associated with this form field, represented as a string.\",\"example\":null,\"type\":\"string\"}},\"required\":[\"isRequired\",\"label\",\"objectType\",\"options\",\"propertyName\"],\"type\":\"object\"},\"type\":\"array\"},\"automatedSalesTaxEnabled\":{\"description\":\"A boolean indicating whether automated sales tax is enabled.\",\"example\":null,\"type\":\"boolean\"},\"businessUnitId\":{\"description\":\"A string representing the business unit ID associated with the payment link.\",\"example\":null,\"type\":\"string\"},\"collectFullBillingAddress\":{\"description\":\"A boolean indicating whether to collect the full billing address during checkout.\",\"example\":null,\"type\":\"boolean\"},\"collectShippingAddress\":{\"description\":\"A boolean indicating whether the shipping address should be collected during checkout.\",\"example\":null,\"type\":\"boolean\"},\"createContractOnPurchase\":{\"description\":\"A boolean indicating whether to create a contract upon purchase.\",\"example\":null,\"type\":\"boolean\"},\"currencyCode\":{\"description\":\"The currency code for the payment, represented as a string.\",\"example\":null,\"type\":\"string\"},\"dealConfigurations\":{\"example\":null,\"properties\":{\"createNewDealOnPurchase\":{\"description\":\"A boolean indicating whether a new deal should be created in HubSpot upon a purchase. Required field.\",\"example\":null,\"type\":\"boolean\"},\"pipelineStageId\":{\"description\":\"The identifier for the pipeline stage where the new deal will be placed. This is a string value.\",\"example\":null,\"type\":\"string\"}},\"required\":[\"createNewDealOnPurchase\"],\"type\":\"object\"},\"descriptionHtml\":{\"description\":\"A string containing the HTML description of the payment link.\",\"example\":null,\"type\":\"string\"},\"discount\":{\"example\":null,\"properties\":{\"label\":{\"description\":\"A descriptive label for the discount. This is a string.\",\"example\":null,\"type\":\"string\"},\"value\":{\"description\":\"The numerical value of the discount to be applied. This is a number.\",\"example\":null,\"type\":\"number\"},\"valueType\":{\"description\":\"The type of discount value, which can either be 'FIXED' or 'PERCENT'.\",\"enum\":[\"FIXED\",\"PERCENT\"],\"example\":null,\"type\":\"string\"}},\"required\":[\"label\",\"value\",\"valueType\"],\"type\":\"object\"},\"discountCodeEnabled\":{\"description\":\"A boolean indicating whether discount codes are enabled for the payment link.\",\"example\":null,\"type\":\"boolean\"},\"discountObjectId\":{\"description\":\"A string representing the object ID of a discount associated with the payment link.\",\"example\":null,\"type\":\"string\"},\"domainId\":{\"description\":\"The domain ID associated with the payment link, represented as a string.\",\"example\":null,\"type\":\"string\"},\"enableDefaultCheckoutFees\":{\"description\":\"A boolean indicating whether default checkout fees are enabled.\",\"example\":null,\"type\":\"boolean\"},\"expirationSettings\":{\"example\":null,\"properties\":{\"expirationDate\":{\"description\":\"The date and time when the payment link will expire, in ISO 8601 format.\",\"example\":null,\"format\":\"date-time\",\"type\":\"string\"},\"maxPurchases\":{\"description\":\"The maximum number of purchases allowed for this payment link. It is an integer value.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"feeObjectIds\":{\"description\":\"An array of strings representing the IDs of fee objects associated with the payment link.\",\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"fees\":{\"description\":\"An array of FeeRequest objects, representing the fees to be applied to the payment link.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"label\":{\"description\":\"A descriptive label for the fee, represented as a string.\",\"example\":null,\"type\":\"string\"},\"value\":{\"description\":\"The numerical value of the fee. This is a number representing either a fixed amount or a percentage, depending on the valueType.\",\"example\":null,\"type\":\"number\"},\"valueType\":{\"description\":\"The type of the fee value, indicating whether it is a fixed amount or a percentage. Valid values include 'FIXED' and 'PERCENT'.\",\"enum\":[\"FIXED\",\"PERCENT\"],\"example\":null,\"type\":\"string\"}},\"required\":[\"label\",\"value\",\"valueType\"],\"type\":\"object\"},\"type\":\"array\"},\"includeEmailInSuccessRedirect\":{\"description\":\"A boolean indicating whether to include the email in the success redirect URL.\",\"example\":null,\"type\":\"boolean\"},\"isOneTimeUseEnabled\":{\"description\":\"A boolean indicating whether the payment link is enabled for one-time use.\",\"example\":null,\"type\":\"boolean\"},\"lineItemObjectIds\":{\"description\":\"An array of line item object IDs associated with the payment link, each represented as a string.\",\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"lineItems\":{\"description\":\"An array of line items, which can be custom, from a product, or cloned, as defined by their respective schemas.\",\"example\":null,\"items\":{\"example\":null,\"oneOf\":[{\"example\":null,\"properties\":{\"allowBuyerSelectedQuantity\":{\"description\":\"A boolean specifying if the buyer can select the quantity of the line item.\",\"example\":null,\"type\":\"boolean\"},\"billingCycleAnchorDate\":{\"description\":\"A string in date format representing the anchor date for the billing cycle.\",\"example\":null,\"format\":\"date\",\"type\":\"string\"},\"billingStartDelayDays\":{\"description\":\"An integer indicating the number of days to delay the start of billing.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"billingStartDelayMonths\":{\"description\":\"An integer indicating the number of months to delay the start of billing.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"buyerSelectedQuantityMax\":{\"description\":\"A number indicating the maximum quantity the buyer can select.\",\"example\":null,\"type\":\"number\"},\"buyerSelectedQuantityMin\":{\"description\":\"A number indicating the minimum quantity the buyer can select.\",\"example\":null,\"type\":\"number\"},\"description\":{\"description\":\"A string providing a description of the line item.\",\"example\":null,\"type\":\"string\"},\"discount\":{\"description\":\"A number representing the discount applied to the line item.\",\"example\":null,\"type\":\"number\"},\"discountPercentage\":{\"description\":\"A number indicating the discount percentage applied to the line item.\",\"example\":null,\"type\":\"number\"},\"externalId\":{\"description\":\"A string representing an external identifier for the line item.\",\"example\":null,\"type\":\"string\"},\"images\":{\"description\":\"A string containing URLs or identifiers for images associated with the line item.\",\"example\":null,\"type\":\"string\"},\"isEditablePrice\":{\"description\":\"A boolean indicating whether the price of the line item is editable.\",\"example\":null,\"type\":\"boolean\"},\"isOptional\":{\"description\":\"A boolean indicating whether the line item is optional.\",\"example\":null,\"type\":\"boolean\"},\"lineItemCurrencyCode\":{\"description\":\"A string representing the currency code for the line item.\",\"example\":null,\"type\":\"string\"},\"mode\":{\"default\":\"CUSTOM\",\"description\":\"A string that indicates the mode of the line item, which is set to 'CUSTOM'.\",\"enum\":[\"CUSTOM\"],\"example\":null,\"type\":\"string\"},\"name\":{\"description\":\"A string representing the name of the line item.\",\"example\":null,\"type\":\"string\"},\"positionOnQuote\":{\"description\":\"An integer indicating the position of the line item on a quote.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"priceBookId\":{\"description\":\"A string that identifies the price book associated with the line item.\",\"example\":null,\"type\":\"string\"},\"pricing\":{\"example\":null,\"properties\":{\"prices\":{\"description\":\"An array of PriceUpdateEntry objects, each specifying the price details such as currency code and price amount for different quantities.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"currencyCode\":{\"description\":\"The currency code in which the price is specified, represented as a string.\",\"example\":null,\"type\":\"string\"},\"maxQuantity\":{\"description\":\"The maximum quantity for which this price is applicable, represented as a string.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"price\":{\"description\":\"An object representing the price details. The specific structure of this object is not detailed in the specification.\",\"example\":null,\"properties\":{},\"type\":\"object\"}},\"required\":[\"currencyCode\",\"price\"],\"type\":\"object\"},\"type\":\"array\"},\"pricingModel\":{\"description\":\"The pricing model applied to the line item. Valid values include 'FLAT', 'GRADUATED', 'STAIRSTEP', and 'VOLUME'.\",\"enum\":[\"FLAT\",\"GRADUATED\",\"STAIRSTEP\",\"VOLUME\"],\"example\":null,\"type\":\"string\"}},\"required\":[\"prices\",\"pricingModel\"],\"type\":\"object\"},\"productId\":{\"description\":\"A string that identifies the product associated with the line item.\",\"example\":null,\"type\":\"string\"},\"productType\":{\"description\":\"A string indicating the type of product for the line item.\",\"example\":null,\"type\":\"string\"},\"quantity\":{\"description\":\"A number indicating the quantity of the line item.\",\"example\":null,\"type\":\"number\"},\"recurringBillingEndDate\":{\"description\":\"A string in date format indicating the end date of recurring billing.\",\"example\":null,\"format\":\"date\",\"type\":\"string\"},\"recurringBillingFrequency\":{\"description\":\"A string specifying the frequency of recurring billing. Valid values include 'ANNUALLY', 'BIWEEKLY', 'MONTHLY', 'PER_FIVE_YEARS', 'PER_FOUR_YEARS', 'PER_SIX_MONTHS', 'PER_THREE_YEARS', 'PER_TWO_YEARS', 'QUARTERLY', and 'WEEKLY'.\",\"enum\":[\"ANNUALLY\",\"BIWEEKLY\",\"MONTHLY\",\"PER_FIVE_YEARS\",\"PER_FOUR_YEARS\",\"PER_SIX_MONTHS\",\"PER_THREE_YEARS\",\"PER_TWO_YEARS\",\"QUARTERLY\",\"WEEKLY\"],\"example\":null,\"type\":\"string\"},\"recurringBillingPeriod\":{\"description\":\"A string representing the period of recurring billing.\",\"example\":null,\"type\":\"string\"},\"recurringBillingStartDate\":{\"description\":\"A string in date format indicating the start date of recurring billing.\",\"example\":null,\"format\":\"date\",\"type\":\"string\"},\"richTextDescription\":{\"description\":\"A string containing a rich text description of the line item.\",\"example\":null,\"type\":\"string\"},\"sku\":{\"description\":\"A string representing the stock keeping unit (SKU) of the line item.\",\"example\":null,\"type\":\"string\"},\"taxCategory\":{\"description\":\"A string representing the tax category of the line item.\",\"example\":null,\"type\":\"string\"},\"taxRateGroupId\":{\"description\":\"The tax rate group ID associated with the line item as a string.\",\"example\":null,\"type\":\"string\"},\"variantId\":{\"description\":\"A string representing the variant identifier of the product.\",\"example\":null,\"type\":\"string\"}},\"required\":[\"mode\",\"name\",\"pricing\",\"quantity\"],\"title\":\"CUSTOM\",\"type\":\"object\"},{\"example\":null,\"properties\":{\"allowBuyerSelectedQuantity\":{\"description\":\"An object indicating whether the buyer can select the quantity of the product.\",\"example\":null,\"properties\":{},\"type\":\"object\"},\"billingCycleAnchorDate\":{\"description\":\"An object representi