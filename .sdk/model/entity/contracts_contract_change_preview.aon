llingStartDelayMonths\":{\"description\":\"An integer representing the delay in months before billing starts.\",\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"buyerSelectedQuantityMax\":{\"description\":\"A number representing the maximum quantity the buyer can select.\",\"example\":null,\"type\":\"number\"},\"buyerSelectedQuantityMin\":{\"description\":\"A number indicating the minimum quantity the buyer can select.\",\"example\":null,\"type\":\"number\"},\"description\":{\"description\":\"A string providing a description of the line item.\",\"example\":null,\"type\":\"string\"},\"discount\":{\"description\":\"A number representing the discount amount applied to the line item.\",\"example\":null,\"type\":\"number\"},\"discountPercentage\":{\"description\":\"A number indicating the discount percentage applied to the line item.\",\"example\":null,\"type\":\"number\"},\"externalId\":{\"description\":\"A string representing an external identifier for the line item.\",\"example\":null,\"type\":\"string\"},\"images\":{\"description\":\"A string containing image URLs associated with the line item.\",\"example\":null,\"type\":\"string\"},\"isEditablePrice\":{\"description\":\"A boolean indicating whether the price of the line item is editable.\",\"example\":null,\"type\":\"boolean\"},\"isOptional\":{\"description\":\"A boolean indicating whether the line item is optional.\",\"example\":null,\"type\":\"boolean\"},\"lineItemCurrencyCode\":{\"description\":\"A string indicating the currency code for the line item.\",\"example\":null,\"type\":\"string\"},\"mode\":{\"default\":\"CUSTOM\",\"description\":\"A string indicating the mode of the line item, which is 'CUSTOM' by default.\",\"enum\":[\"CUSTOM\"],\"example\":null,\"type\":\"string\"},\"name\":{\"description\":\"A string representing the name of the line item.\",\"example\":null,\"type\":\"string\"},\"positionOnQuote\":{\"description\":\"An integer indicating the position of the line item on the quote.\",\