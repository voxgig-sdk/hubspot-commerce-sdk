# Entity: contracts_contract_change_preview

main: kit: entity: contracts_contract_change_preview: {

  alias: field: {}

  fields: {
    deltaLineItems: {
      h: "Delta Line Items"
      n: "deltaLineItems"
      r: true
      sh: "An array of LineItem objects representing the changes in line items compared to the current state of the contract."
      t: "`$ARRAY`"
    }
    proposedLineItems: {
      h: "Proposed Line Items"
      n: "proposedLineItems"
      r: true
      sh: "An array of LineItem objects representing the proposed state of line items after the changes are applied."
      t: "`$ARRAY`"
    }
  }

  name: "contracts_contract_change_preview"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
