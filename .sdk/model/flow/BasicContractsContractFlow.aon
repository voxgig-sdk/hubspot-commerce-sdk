# BasicContractsContractFlow

main: kit: flow: BasicContractsContractFlow:
{
  entity: "contracts_contract",
  kind: "basic",
  name: "BasicContractsContractFlow",
  step: [
    {
      input: {
        ref: "contracts_contract_ref01"
      }

      match: {
        contract_id: "contract01"
      }

      op: "create"
    }
  ],
  "key$": "BasicContractsContractFlow"
}