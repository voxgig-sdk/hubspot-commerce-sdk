# BasicContractFlow

main: kit: flow: BasicContractFlow:
{
  entity: "contract",
  kind: "basic",
  name: "BasicContractFlow",
  step: [
    {
      input: {
        ref: "contract_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "contract_ref01",
        srcdatavar: "contract_ref01_data",
        suffix: "_up0",
        textfield: "allTransactionsFeeName"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contract_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contract_ref01",
        srcdatavar: "contract_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "contract01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contract_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContractFlow"
}