# BasicPriceBookFlow

main: kit: flow: BasicPriceBookFlow:
{
  entity: "price_book",
  kind: "basic",
  name: "BasicPriceBookFlow",
  step: [
    {
      i: {
        ref: "price_book_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "price_book_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "price_book_ref01",
        srcdatavar: "price_book_ref01_data",
        suffix: "_up0",
        textfield: "archivedAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-price_book_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "price_book_ref01",
        srcdatavar: "price_book_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "price_book01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-price_book_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPriceBookFlow"
}