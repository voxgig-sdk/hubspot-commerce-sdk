# BasicPaymentLinkFlow

main: kit: flow: BasicPaymentLinkFlow:
{
  entity: "payment_link",
  kind: "basic",
  name: "BasicPaymentLinkFlow",
  step: [
    {
      input: {
        ref: "payment_link_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "payment_link_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "payment_link_ref01",
        srcdatavar: "payment_link_ref01_data",
        suffix: "_up0",
        textfield: "archivedAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-payment_link_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "payment_link_ref01",
        srcdatavar: "payment_link_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "payment_link01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-payment_link_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaymentLinkFlow"
}